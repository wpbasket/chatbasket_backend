# Appwrite Configuration
APPWRITE_ENDPOINT=https://example.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=your_database_id_here
APPWRITE_USERS_COLLECTION_ID=your_users_collection_id
APPWRITE_POSTS_COLLECTION_ID=your_posts_collection_id
APPWRITE_REFRESH_TOKENS_COLLECTION_ID=your_refresh_tokens_collection_id
APPWRITE_LIKES_COLLECTION_ID=your_likes_collection_id
APPWRITE_FOLLOW_COLLECTION_ID=your_follow_collection_id
APPWRITE_COMMENTS_COLLECTION_ID=your_comments_collection_id
APPWRITE_BLOCK_COLLECTION_ID=your_block_collection_id
APPWRITE_FOLLOW_REQUESTS_COLLECTION_ID=your_follow_requests_collection_id
APPWRITE_TEMP_OTP_COLLECTION_ID=your_temp_otp_collection_id
APPWRITE_FILE_USERPROFILEPIC_BUCKET_ID=your_file_userprofilepic_bucket_id
APPWRITE_PERSONAL_DATABASE_ID=your_personal_database_id
APPWRITE_PERSONAL_USERS_COLLECTION_ID=users
APPWRITE_PERSONAL_ALONE_USERNAME_COLLECTION_ID=alone_username
PERSONAL_USERNAME_KEY=your_base64_encoded_key_here
APPWRITE_FILE_PERSONAL_USERPROFILEPIC_BUCKET_ID=your_personal_userprofilepic_bucket_id

# PostgreSQL Database URLs
DATABASE_URL_PG_CB=postgres://username:password@host:5432/cb?sslmode=require
DATABASE_URL_PG_DEV=postgres://username:password@host:5432/dev?sslmode=require

# Azure Cosmos DB (NoSQL API) Configuration
COSMOS_CONNECTION_STRING=AccountEndpoint=https://your-account.documents.azure.com:443/;AccountKey=your_account_key;
COSMOS_DATABASE=db01
COSMOS_CONTAINER=container01

# Firebase Credentials (if needed)
# FIREBASE_CREDENTIALS_JSON={}
